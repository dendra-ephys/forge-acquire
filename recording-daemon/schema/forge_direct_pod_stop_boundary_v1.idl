forge_direct_pod_stop_boundary ForgeDirectPodStopBoundaryV1 {
  byte_order = little_endian;
  version = 1;
  checksum = crc32c_castagnoli;
  contract_hash = sha256(utf8_lf(this_file));
  parent_protocol_hash = forge_protocol_v1.contract_hash;

  // The Receiver Pod emits every final canonical record before the matching
  // Stop AckV1 on the same ordered IN stream. The host appends each record to
  // its journal before updating this boundary. AckV1.receipt_hash is the
  // SHA-256 of the exact 208-byte value below.
  struct DirectPodStopBoundaryV1 @size(208) {
    0 magic: bytes[8] = "FGRSTOP1";
    8 version: u16 = 1; 10 body_len: u16 = 208;
    12 reserved0: u32 = 0;
    16 contract_hash: bytes[32] = sha256(utf8_lf(this_file));
    48 run_id: bytes[16]; 64 device_id: bytes[16];
    80 pod_id: bytes[16]; 96 headstage_id: bytes[16];
    112 transport_epoch: u64; 120 stop_request_id: u64;
    128 source_record_count: u64; 136 last_record_sequence: u64;
    144 last_frame_end_exclusive: u64;
    152 last_sample_end_exclusive: u64;
    160 last_global_time_end_exclusive_ns: u64;
    168 parent_protocol_hash: bytes[32];
    200 reserved1: u32 = 0;
    204 crc32c: u32 = crc32c(bytes[0..204]);
  }

  // For a successful Stop acknowledgement in this binding:
  // AckV1.ack_code = 1 (APPLIED), AckV1.state_code = 4 (STOPPED), and
  // AckV1.receipt_hash = sha256(DirectPodStopBoundaryV1 bytes).
}
